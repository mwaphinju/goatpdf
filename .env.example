# Copy this file to .env.local for local development (already gitignored) and
# fill in only the values you need. Every variable below is optional — GOAT
# PDF runs correctly with none of them set.

# --- Google Analytics 4 -----------------------------------------------------
# Your GA4 Web Data Stream's Measurement ID (starts with "G-"). Found in the
# GA4 Admin panel: Admin > Data streams > (your web stream) > Measurement ID.
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time,
# so this must be set before `next build` runs (see the Dockerfile's ARG/ENV
# bridge for how that reaches a Docker build). Leave unset to disable GA4
# entirely — no script is loaded and no events are sent. See ANALYTICS.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Site URL (SEO: canonical links, Open Graph, sitemap.xml) --------------
# Defaults to a placeholder if unset. Set to your real production domain.
NEXT_PUBLIC_SITE_URL=

# --- Internal, privacy-conscious usage analytics (self-hosted, optional) ---
# Distinct from GA4 above — this app's own minimal event log, off by default.
# See README.md's "Analytics" section for the full explanation.
ANALYTICS_ENABLED=false
ANALYTICS_ENDPOINT_URL=
ANALYTICS_SITE_ID=

# --- PDF to Word (LibreOffice) ----------------------------------------------
# Path to the soffice binary. Usually unnecessary: auto-detected on PATH
# (the Docker image) or common Windows install locations (local dev).
SOFFICE_PATH=
